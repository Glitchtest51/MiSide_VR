{
  "app_key": "application.generated.unity.miside_vrproject.exe",
  "bindings": {
    "/actions/buggy": { "chords": [], "poses": [], "haptics": [], "sources": [], "skeleton": [] },
    "/actions/default": { "chords": [], "poses": [], "haptics": [], "sources": [], "skeleton": [] },
    "/actions/gameplay": {
      "chords": [],
      "poses": [
        { "output": "/actions/gameplay/in/pose", "path": "/user/hand/left/pose/raw" },
        { "output": "/actions/gameplay/in/pose", "path": "/user/hand/right/pose/raw" }
      ],
      "haptics": [
        { "output": "/actions/gameplay/out/haptic", "path": "/user/hand/left/output/haptic" },
        { "output": "/actions/gameplay/out/haptic", "path": "/user/hand/right/output/haptic" }
      ],
      "sources": [
        { "path": "/user/hand/left/input/thumbstick", "mode": "joystick", "parameters": {}, "inputs": { "click": { "output": "/actions/gameplay/in/sprint" }, "position": { "output": "/actions/gameplay/in/move" } } },
        { "path": "/user/hand/right/input/thumbstick", "mode": "joystick", "parameters": {}, "inputs": { "click": { "output": "/actions/gameplay/in/sprint" }, "position": { "output": "/actions/gameplay/in/turn" } } },
        { "path": "/user/hand/left/input/grip", "mode": "grab", "parameters": { "force_hold_threshold": "0.02", "force_release_threshold": "0.01" }, "inputs": { "grab": { "output": "/actions/gameplay/in/grableft" } } },
        { "path": "/user/hand/right/input/grip", "mode": "grab", "parameters": { "force_hold_threshold": "0.02", "force_release_threshold": "0.01" }, "inputs": { "grab": { "output": "/actions/gameplay/in/grabright" } } },
        { "path": "/user/hand/left/input/trigger", "mode": "button", "parameters": {}, "inputs": { "click": { "output": "/actions/gameplay/in/lefttrigger" } } },
        { "path": "/user/hand/right/input/trigger", "mode": "button", "parameters": {}, "inputs": { "click": { "output": "/actions/gameplay/in/righttrigger" } } },
        { "path": "/user/hand/left/input/b", "mode": "button", "parameters": {}, "inputs": { "click": { "output": "/actions/gameplay/in/menu" } } },
        { "path": "/user/hand/right/input/a", "mode": "button", "parameters": {}, "inputs": { "click": { "output": "/actions/gameplay/in/calibrateheight" } } }
      ],
      "skeleton": [
        { "output": "/actions/gameplay/in/skeletonlefthand", "path": "/user/hand/left/input/skeleton/left" },
        { "output": "/actions/gameplay/in/skeletonrighthand", "path": "/user/hand/right/input/skeleton/right" }
      ]
    },
    "/actions/platformer": { "chords": [], "poses": [], "haptics": [], "sources": [], "skeleton": [] }
  },
  "controller_type": "knuckles",
  "description": "MiSide VR bindings for Valve Index controllers",
  "name": "MiSide VR - Valve Index"
}
